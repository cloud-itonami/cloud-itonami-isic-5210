{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; Unlike `cloud-itonami-isic-4920` (which wraps a pre-existing bespoke
 ;; capability library `kotoba-lang/logistics`), this terminal-storage
 ;; vertical is SELF-CONTAINED: there is no `kotoba-lang/petroleum-terminal`
 ;; to delegate tank-overfill / tank-integrity / bonding-grounding validation
 ;; to, so the overfill-risk / API-653-integrity / bonding-grounding / POD-
 ;; chain checks live as pure functions in `terminal.registry` rather than
 ;; wrapping an external lib. This repo is standalone (forkable outside the
 ;; workspace); the :local/root paths only resolve inside the monorepo
 ;; checkout -- a standalone fork should override them with git coordinates.
 :deps {io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "terminal.sim"]}
  ;; clojure -M:dev:render-html [out-file] -> regenerate docs/samples/operator-console.html
  ;; through the real actor (flagship checklist item 2, ADR-2607189300 Wave5 seq 11).
  :render-html {:main-opts ["-m" "terminal.render-html"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
